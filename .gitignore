# Dev-only content served by the local Apache vhost for testing.
# Not part of the module; regenerate from scratch if needed.
/testsite/

# apxs / libtool build artifacts
*.o
*.lo
*.la
*.slo
*.so
.libs/

# Editor/scratch
*.swp
*~
.DS_Store
.vscode/

# Python test framework (M11.4+) — venv + pytest caches + egg-info
# are per-box artifacts that don't belong in the repo.
tests/.venv/
tests/.pytest_cache/
tests/*.egg-info/
__pycache__/
