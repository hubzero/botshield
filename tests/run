#!/bin/bash
# tests/run — mod_botshield test dispatcher.
#
# Fires pytest against tests/pytests/ (the M11.4+ rebuild) and reports
# a summary. Stress/soak (tests/stress/) is opt-in via --only stress.
#
# Exit codes: 0 if every test passed, 1 if any failed, 2 on bad
# invocation.
#
# Flags:
#   --only CATEGORY    Run only one category (pytests, stress).
#                      Repeatable. Use 'all' to include stress
#                      alongside pytests.
#   --match PATTERN    Substring filter. Passed to pytest as -k, and
#                      to the stress dispatcher as a filename filter.
#   --parallel         Run pytests with xdist in two phases:
#                      non-serial tests in parallel (-n auto), then
#                      serial tests sequentially. Default is fully
#                      sequential (-n 0).
#   --slow             Include tests marked @slow (e.g. the 40s
#                      periodic-save watchdog wait). Excluded by
#                      default so the suite finishes fast.
#   --verbose          Show each test's stdout inline instead of
#                      only on failure.
#   --list             List tests that would run, don't execute.
#
# Conventions:
#   - Every test lives under tests/pytests/ and uses the fixtures
#     in tests/conftest.py + helpers in tests/botshield_test/.
#   - Tests MUST NOT depend on ordering within their category.
#   - Tests that mutate shared Apache state (config swap, restart)
#     are marked @pytest.mark.serial and run outside the xdist pool.
#   - A test needing a completely clean SHM/state should call the
#     `clean_state` fixture.
#
# Bash test archive: tests/bash-legacy/ holds the M11.1–M11.3
# shell-based tests as a reference. Not executed.

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
PYTEST_VENV="$HERE/.venv"

DEFAULT_CATEGORIES=(pytests)
ALL_CATEGORIES=(pytests stress)
CATEGORIES=("${DEFAULT_CATEGORIES[@]}")

ONLY=()
MATCH=""
VERBOSE=0
LIST_ONLY=0
PARALLEL=0
SLOW=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --only)
      if [[ "$2" == "all" ]]; then
        ONLY=("${ALL_CATEGORIES[@]}")
      else
        ONLY+=("$2")
      fi
      shift 2 ;;
    --match)    MATCH="$2";   shift 2 ;;
    --parallel) PARALLEL=1;   shift   ;;
    --slow)     SLOW=1;       shift   ;;
    --verbose)  VERBOSE=1;    shift   ;;
    --list)     LIST_ONLY=1;  shift   ;;
    --help|-h)
      sed -n '3,32p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done

if [[ ${#ONLY[@]} -gt 0 ]]; then
  CATEGORIES=("${ONLY[@]}")
fi

pass=0
fail=0
skip=0
fails=()

run_pytests() {
  local dir="$HERE/pytests"
  if [[ ! -x "$PYTEST_VENV/bin/pytest" ]]; then
    # Missing venv is a hard fail, not a silent skip. If the canonical
    # runner exits 0/0/0 just because provision.sh wasn't run, every
    # "CI is green" signal is a lie. Force a non-zero exit with a
    # clear diagnostic.
    echo ""
    echo "=== pytests ==="
    echo "  FAIL: no pytest venv at $PYTEST_VENV"
    echo "  Run: sudo tests/setup/provision.sh"
    fail=$(( fail + 1 ))
    fails+=("pytests (venv missing)")
    return
  fi
  if [[ $LIST_ONLY -eq 1 ]]; then
    "$PYTEST_VENV/bin/pytest" "$dir" --collect-only -q 2>/dev/null | \
      grep "::" | sed 's|^|pytests/|'
    return
  fi

  printf "\n=== pytests ===\n"

  # Slow tests opt-in; default filter excludes them.
  local slow_filter=""
  [[ $SLOW -eq 0 ]] && slow_filter="not slow"

  # Invoke pytest once for a given marker filter + xdist jobcount.
  _one_pytest_invocation() {
    local marker="$1" njobs="$2"
    local m_expr="$marker"
    if [[ -n "$slow_filter" ]]; then
      if [[ -n "$m_expr" ]]; then
        m_expr="($m_expr) and $slow_filter"
      else
        m_expr="$slow_filter"
      fi
    fi
    local pyout; pyout=$(mktemp /tmp/bs_pytest_out.XXXXXX)
    local args=("$dir" --tb=short --no-header -p no:cacheprovider)
    [[ -n "$MATCH"  ]] && args+=(-k "$MATCH")
    [[ -n "$m_expr" ]] && args+=(-m "$m_expr")
    [[ -n "$njobs"  ]] && args+=(-n "$njobs")
    [[ $VERBOSE -eq 1 ]] && args+=(-v) || args+=(-q)

    local rc=0
    ( cd "$HERE" && "$PYTEST_VENV/bin/pytest" "${args[@]}" ) \
        > "$pyout" 2>&1 || rc=$?

    local p s f
    p=$(grep -oE "[0-9]+ passed"  "$pyout" | head -1 | awk '{print $1}')
    s=$(grep -oE "[0-9]+ skipped" "$pyout" | head -1 | awk '{print $1}')
    f=$(grep -oE "[0-9]+ failed"  "$pyout" | head -1 | awk '{print $1}')
    pass=$(( pass + ${p:-0} ))
    skip=$(( skip + ${s:-0} ))
    fail=$(( fail + ${f:-0} ))

    # pytest exit codes (from pytest docs):
    #   0 = all passed, 1 = some failed, 2 = interrupted,
    #   3 = internal error, 4 = cli misuse, 5 = no tests collected.
    # Exit 5 is expected during a --parallel run when one phase's
    # filter (serial / not-serial) intersected with --match or --slow
    # yields an empty selection. It's not a failure; treat as benign.
    if [[ $rc -eq 5 ]]; then
      [[ $VERBOSE -eq 1 ]] && cat "$pyout"
    elif [[ $rc -ne 0 ]]; then
      fails+=("pytests${marker:+ [$marker]} (${f:-?} failed)")
      cat "$pyout"
    elif [[ $VERBOSE -eq 1 ]]; then
      cat "$pyout"
    else
      grep -E "^(PASSED|SKIPPED|FAILED|pytests/|=+)" "$pyout" | tail -20
    fi
    rm -f "$pyout"
  }

  if [[ $PARALLEL -eq 1 ]]; then
    _one_pytest_invocation "not serial" "auto"
    _one_pytest_invocation "serial" ""
  else
    _one_pytest_invocation "" ""
  fi
}

run_stress() {
  local dir="$HERE/stress"
  [[ -d "$dir" ]] || return
  for t in "$dir"/*.sh; do
    [[ -e "$t" ]] || continue
    [[ -x "$t" ]] || continue
    local name="stress/$(basename "$t" .sh)"
    if [[ -n "$MATCH" ]] && [[ "$name" != *"$MATCH"* ]]; then continue; fi
    if [[ $LIST_ONLY -eq 1 ]]; then echo "$name"; continue; fi

    printf "\n=== %s ===\n" "$name"
    local out; out=$(mktemp /tmp/bs_test_out.XXXXXX)
    if "$t" > "$out" 2>&1; then
      if grep -q "soak: PASS\|PASS:" "$out"; then
        pass=$((pass + 1))
        grep -E "soak: PASS|^  PASS:" "$out" | tail -5
      else
        fail=$((fail + 1))
        fails+=("$name")
        echo "  FAIL: stress test exited 0 but no PASS marker found"
        cat "$out"
      fi
    else
      fail=$((fail + 1))
      fails+=("$name")
      cat "$out"
    fi
    rm -f "$out"
  done
}

for cat in "${CATEGORIES[@]}"; do
  case "$cat" in
    pytests) run_pytests ;;
    stress)  run_stress  ;;
    *) echo "unknown category: $cat (valid: pytests, stress, all)" >&2
       exit 2 ;;
  esac
done

if [[ $LIST_ONLY -eq 1 ]]; then
  exit 0
fi

echo ""
echo "====================================================="
printf "tests: %d passed, %d skipped, %d failed\n" "$pass" "$skip" "$fail"
if [[ $fail -gt 0 ]]; then
  echo "failed:"
  for f in "${fails[@]}"; do echo "  - $f"; done
  exit 1
fi
exit 0
