# Environment for running the pytest suite against the ISOLATED test
# httpd (httpd-bstest), never the live server.
#
# BS_APACHE_SERVICE is the dangerous one: the framework calls
# `sudo systemctl restart $BS_APACHE_SERVICE` between tests. Pointed at
# "httpd" it would restart the production site dozens of times.
export BS_BASE=https://localhost:8443
export BS_APACHE_SERVICE=httpd-bstest
export BS_DEV_VHOST_CONF=/etc/httpd/bstest/dev-vhost.conf
export BS_ERROR_LOG=/var/log/httpd/bstest/botshield-dev-error.log
export BS_APACHE_ERROR_LOG=/var/log/httpd/bstest/error.log
export BS_STATE_FILE=/var/lib/botshield-test/state.bin
