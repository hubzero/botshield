[Unit]
Description=Refresh BotShield verified-bot IP ranges daily
Documentation=file:/usr/local/share/botshield/refresh-bot-ranges.sh

[Timer]
# Daily is well inside how often these providers actually change their
# published ranges, and the module only picks up new files on restart
# anyway, so a tighter cadence buys nothing.
OnCalendar=daily
# Spread the fetch across an hour. Every host running this would
# otherwise hit the same four providers at the same instant.
RandomizedDelaySec=1h
# Catch up after downtime rather than skipping a day silently.
Persistent=true

[Install]
WantedBy=timers.target
