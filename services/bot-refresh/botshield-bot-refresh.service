[Unit]
# Refreshes the verified-crawler IP range files that mod_botshield's
# allow list reads at startup. Oneshot, driven by the paired .timer.
#
# Nothing depends on this and httpd does not wait for it. A refresh
# that fails leaves the previous ranges in place, which is the correct
# outcome: stale published ranges are far better than none, and a
# provider having a bad day must not cost this host its allow list.
Description=BotShield verified-bot IP range refresh
Documentation=file:/usr/local/share/botshield/refresh-bot-ranges.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/share/botshield/refresh-bot-ranges.sh

# The script rewrites files under the module's data directory, so it
# needs write access there and nowhere else.
ProtectSystem=strict
ReadWritePaths=/var/lib/botshield/bots
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Exit 1 means some providers refreshed and others did not. That is a
# normal outcome worth seeing in the journal, not a unit failure --
# every provider that did refresh has already been written.
SuccessExitStatus=0 1

Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300
